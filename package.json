    "nuxt": "^4.4.8",
    "nuxt-security": "^2.6.0",
    "tailwindcss": "^4.3.2",
    "valibot": "^1.4.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@dethdkn/ox-config": "^1.0.23",
